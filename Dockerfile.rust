# Robotocore — pure-Rust server image (no Python).
# Multi-stage cargo build; runtime ships only the binary.

FROM rust:1.89-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY rotocore/Cargo.toml rotocore/Cargo.toml
COPY crates/*/Cargo.toml crates/
RUN mkdir -p src crates && echo "" > src/lib.rs && cargo build --release -q 2>/dev/null || true

# Copy sources and build for real
COPY src/ src/
COPY rotocore/ rotocore/
COPY crates/ crates/
COPY contracts/ contracts/
COPY data/ data/
COPY docs/ docs/
COPY .git/ .git/
RUN cargo build --release && strip target/release/robotocore-rust

FROM gcr.io/distroless/cc AS runtime

ARG ROBOTOCORE_VERSION=1.0.0
ENV ROBOTOCORE_VERSION=${ROBOTOCORE_VERSION}
ENV ROBOTOCORE_HOST=0.0.0.0

COPY --from=builder /app/target/release/robotocore-rust /server/robotocore-rust
EXPOSE 4566
ENTRYPOINT ["/server/robotocore-rust", "--host", "0.0.0.0"]
